# Generate a long random token, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
HARNESS_API_TOKEN=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=replace-with-dev-only-credential
HARNESS_MODEL=deepseek-v4-flash
HARNESS_PROVIDER=deepseek-official
HARNESS_PROFILE=sdk-minimal
HARNESS_TASK_TIMEOUT_SECONDS=900

# Maximum pending research tasks in the same resident Harness container
HARNESS_MAX_QUEUED_TASKS=32
